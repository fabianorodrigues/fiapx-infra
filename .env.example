## Configuracao DEMO/local versionavel.
## Nao use tokens, senhas pessoais, credenciais cloud ou secrets reais aqui.
## Para configuracao privada local, crie um arquivo .env ignorado pelo Git.

POSTGRES_DB=fiapx_videos
POSTGRES_USER=fiapx
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432

REDIS_PORT=6379
CACHE_TTL_SECONDS=30

KEYCLOAK_PORT=8081
KEYCLOAK_HOSTNAME=http://localhost:8081
KEYCLOAK_ADMIN_USERNAME=change-me-local-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak-admin-password

JWT_METADATA_ADDRESS=http://keycloak:8080/realms/fiapx/.well-known/openid-configuration
JWT_ISSUER=http://localhost:8081/realms/fiapx
JWT_AUDIENCE=video-management-service

MINIO_ROOT_USER=fiapx-dev
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_BUCKET=videos
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_REQUEST_TIMEOUT_SECONDS=3
MINIO_MAX_ERROR_RETRY=0
PRESIGNED_URL_EXPIRES_SECONDS=900

VIDEO_MANAGEMENT_IMAGE=fiapx-video-management:local
VIDEO_PROCESSING_IMAGE=fiapx-video-processing:local
VIDEO_MANAGEMENT_PORT=8080

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@fiapx.local

RABBITMQ_DEFAULT_USER=fiapx
RABBITMQ_DEFAULT_PASS=change-me-local-rabbitmq-password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_DELAY_MS=5000
STATUS_MAX_ATTEMPTS=3
STATUS_RETRY_DELAY_MS=5000

FIAPX_E2E_USERTEST1_USERNAME=usertest1
FIAPX_E2E_USERTEST1_PASSWORD=fiapx_usertest1_demo_password
FIAPX_E2E_USERTEST2_USERNAME=usertest2
FIAPX_E2E_USERTEST2_PASSWORD=fiapx_usertest2_demo_password
FIAPX_E2E_BOOTSTRAP_USERS=false
